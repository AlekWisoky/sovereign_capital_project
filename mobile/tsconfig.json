{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "node",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true
  },
  "include": [
    "src/utils/amounts.ts",
    "src/utils/launch.ts",
    "src/state/launchStore.ts",
    "src/commandCenter/types.ts",
    "src/commandCenter/executionSummary.ts",
    "tests/**/*.ts"
  ]
}
