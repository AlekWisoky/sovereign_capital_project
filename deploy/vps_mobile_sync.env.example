# Backend VPS environment example for a Netlify-hosted x∆v mobile/web frontend.
# Set these values in your VPS service manager or docker compose environment.
VICTOR_CONFIG=/app/backend/config/ethereum.yaml
VICTOR_LOG_JSON=1
VICTOR_ADMIN_KEY=change-me
VICTOR_AUTOSTART=1
VICTOR_DEPLOYMENT_MODE=private
# Comma-separated allowed browser origins for the hosted web app.
VICTOR_CORS_ALLOW_ORIGINS=https://your-netlify-site.netlify.app,https://app.yourdomain.com
